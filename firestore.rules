rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isRole(role) {
      return isAuthenticated() && getRole() == role;
    }

    function isAnyRole(roles) {
      return isAuthenticated() && getRole() in roles;
    }

    function isAdminIncharge() {
      return isRole('admin_incharge');
    }

    function isEmployee() {
      return isRole('employee');
    }

    function isCMO() {
      return isRole('cmo');
    }

    function isDoctor() {
      return isAnyRole(['doctor', 'cmo']);
    }

    function isReception() {
      return isRole('reception');
    }

    function isMedicalStaff() {
      return isAnyRole(['doctor', 'cmo', 'nurse', 'reception']);
    }

    // Day 14 (Phase 4, Step E fix) — admin_incharge or cmo only, used by the
    // employees/{employeeId}/private subcollection below.
    function isAdminOrCMO() {
      return isAnyRole(['admin_incharge', 'cmo']);
    }

    // ─── USERS ───────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() &&
                    (request.auth.uid == userId || isMedicalStaff() || isAdminIncharge());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() &&
                    (request.auth.uid == userId || isAdminIncharge());
      allow delete: if isAdminIncharge();
    }

    // ─── EMPLOYEES ───────────────────────────────────────
    // Day 14 (Phase 4, Step E fix): self-update is now restricted to a
    // specific field list. Previously an employee could write ANY field on
    // their own record — Firestore rules are the only real enforcement
    // boundary for direct client SDK access (the Express backend's Step A
    // field-gating only protects requests that go through it, not direct
    // Firestore writes). Admin is unaffected — full write access retained.
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
                    (isAdminIncharge() ||
                     (get(/databases/$(database)/documents/employees/$(employeeId)).data.userId == request.auth.uid &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'fullName', 'phoneNumber', 'emergencyPhoneNumber', 'landlineExtension',
                        'houseNumber', 'roomNumber', 'townshipResidentWithFamily',
                        'townshipResidentBachelor', 'residenceType', 'cityOfResidence',
                        'maritalStatus', 'bloodDonorConsent', 'isSmoker',
                        'correctionRequested', 'correctionRequestNote', 'updatedAt'
                      ])));
      allow delete: if isAdminIncharge();

      // Family members subcollection (kept for backward compatibility)
      match /familyMembers/{memberId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() &&
                     (isAdminIncharge() ||
                      get(/databases/$(database)/documents/employees/$(employeeId)).data.userId == request.auth.uid);
      }

      // Day 14 (Phase 4, Step E fix) — sensitive fields that must NOT be
      // readable via the open employees/{employeeId} read rule above.
      // Firestore rules can't hide a single field within an otherwise-open
      // document, so anything admin/CMO-only (currently: chronic disease)
      // lives here instead, in its own restricted document.
      match /private/{docId} {
        allow read:  if isAdminOrCMO();
        allow write: if isAdminOrCMO();
      }
    }

    // ─── FAMILY MEMBERS (top-level collection) ───────────
    match /familyMembers/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
                    (isAdminIncharge() ||
                     resource.data.employeeId == request.auth.uid);
      allow delete: if isAdminIncharge();
    }

    // ─── AMBULANCE REQUESTS ──────────────────────────────
    // Day 16 (Phase 5, Step 5.1 fix): previously any employee could write
    // ANY field to ANY ambulance request via direct client SDK, bypassing
    // every role/state check the Express backend enforces (accept, assign,
    // dispatch, pickup, return, complete, cancel all live in
    // ambulanceRoutes.js, not here). Read was also fully open to any
    // authenticated user, exposing patientCondition and other request
    // details beyond who the backend itself would show them to.
    //
    // Every create/update/delete the app performs already goes through
    // ambulanceRoutes.js using the Admin SDK, which is NOT subject to these
    // rules — so locking direct client writes to false here does not
    // remove any functionality the app actually uses. It only closes the
    // direct-Firestore side door. Read is narrowed to match the same role
    // list the backend's own GET /:id and GET /active endpoints allow.
    //
    // If a future subphase adds a legitimate direct-client write (e.g.
    // employee self-service in Phase 5.5), that specific case should be
    // added explicitly here — not by reopening this block broadly.
    match /ambulanceRequests/{requestId} {
      allow read:   if isAnyRole(['reception', 'driver', 'cmo', 'admin_incharge']);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── MEDICAL TRIPS ───────────────────────────────────
    match /medicalTrips/{tripId} {
      allow read: if isAuthenticated();
      allow create: if isAnyRole(['reception', 'cmo']);
      allow update: if isAnyRole(['reception', 'doctor', 'cmo']);
      allow delete: if isAnyRole(['reception', 'cmo']);

      match /bookings/{bookingId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAnyRole(['reception', 'doctor', 'cmo', 'employee']);
        allow delete: if isAnyRole(['reception', 'cmo']);
      }
    }

    // ─── VACCINATION PROFILES ────────────────────────────
    match /vaccinationProfiles/{profileId} {
      allow read: if isAuthenticated();
      allow create: if isAnyRole(['nurse', 'reception', 'cmo']);
      allow update: if isAnyRole(['nurse', 'doctor', 'cmo', 'reception']);
      allow delete: if isAnyRole(['nurse', 'cmo']);

      match /scheduleItems/{itemId} {
        allow read: if isAuthenticated();
        allow write: if isAnyRole(['nurse', 'doctor', 'cmo', 'reception']);
      }
    }

    // ─── VACCINATION RECORDS (top-level collection) ──────
    match /vaccinationRecords/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAnyRole(['nurse', 'doctor', 'cmo', 'reception']);
      allow update: if isAnyRole(['nurse', 'doctor', 'cmo', 'reception']);
      allow delete: if isAnyRole(['nurse', 'cmo']);
    }

    // ─── VACCINE SCHEDULE ────────────────────────────────
    match /vaccineSchedule/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAnyRole(['nurse', 'cmo', 'admin_incharge']);
    }

    // ─── NOTIFICATIONS ───────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAnyRole(['doctor', 'cmo', 'nurse', 'reception',
                                   'lab_technologist', 'pharmacy_incharge',
                                   'admin_incharge']);
      allow update: if isAnyRole(['doctor', 'cmo', 'reception']);
      allow delete: if isAnyRole(['doctor', 'cmo']);

      match /receipts/{receiptId} {
        allow read: if isAuthenticated() && request.auth.uid == receiptId;
        allow write: if isAuthenticated() && request.auth.uid == receiptId;
      }
    }

    // ─── DOCTOR AVAILABILITY ─────────────────────────────
    match /doctorAvailability/{doctorId} {
      allow read: if isAuthenticated();
      allow write: if isAnyRole(['doctor', 'cmo', 'reception']);

      match /statusLog/{logId} {
        allow read: if isAnyRole(['doctor', 'cmo', 'reception']);
        allow create: if isAnyRole(['doctor', 'cmo', 'reception']);
        allow delete: if false;
      }
    }

    // ─── FITNESS APPOINTMENTS ────────────────────────────
    match /fitnessAppointments/{appointmentId} {
      allow read: if isAuthenticated();
      allow create: if isRole('admin_incharge');
      allow update: if isAnyRole(['admin_incharge', 'doctor', 'cmo', 'employee']);
      allow delete: if isRole('admin_incharge');
    }

    // ─── DOCTORS DIRECTORY ───────────────────────────────
    match /doctorsDirectory/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isAnyRole(['doctor', 'cmo', 'nurse', 'reception']);
    }

    // ─── FEEDBACK ────────────────────────────────────────
    match /feedback/{feedbackId} {
      allow read: if isAnyRole(['doctor', 'cmo', 'reception']);
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isCMO();
    }

    // ─── BLOOD DONOR REGISTRY ────────────────────────────
    // Day 14 fix: entries for family members use doc ID `family_{memberId}`,
    // which never equals the writer's own uid — the original rule only
    // ever matched employee-keyed entries (doc ID == uid), so every family
    // member consent write to this collection was silently rejected.
    // Fixed by also allowing a write when the doc ID is a family-prefixed
    // one AND the referenced familyMembers doc actually belongs to the
    // caller (looked up by employeeId, same ownership check used
    // elsewhere for that collection).
    match /bloodDonorRegistry/{registryId} {
      allow read: if isAnyRole(['doctor', 'cmo', 'reception', 'nurse']);
      allow write: if isAuthenticated() &&
                   (request.auth.uid == registryId ||
                    isAdminIncharge() ||
                    (registryId.matches('^family_.*') &&
                     get(/databases/$(database)/documents/familyMembers/$(registryId.split('_')[1])).data.employeeId == request.auth.uid));
    }

    // ─── WORKING HOURS ───────────────────────────────────
    match /workingHours/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isCMO();
    }

    // ─── HEALTH TIPS ─────────────────────────────────────
    match /healthTips/{tipId} {
      allow read: if isAuthenticated();
      allow write: if isAdminIncharge();
    }

  }
}
